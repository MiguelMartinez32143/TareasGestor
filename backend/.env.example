# ==========================================
# VARIABLES DE ENTORNO — GESTOR DE TAREAS
# ==========================================
# ✅ TASK-15: Archivo de ejemplo para nuevos entornos — agregado por auditoría
#
# Copia este archivo como .env y completa los valores.
# En Railway, estas variables se configuran en el dashboard.

# Puerto del servidor backend
PORT=3000

# Credenciales de conexión a MySQL
# Railway provee automáticamente MYSQLHOST, MYSQLUSER, etc.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=tareas_db

# Alternativa: URL de conexión completa (si tu hosting la provee)
# DATABASE_URL=mysql://user:password@host:port/database

# URL del Frontend (para CORS en producción)
FRONTEND_URL=
CORS_ORIGIN_PROD=

# Secreto para firmar tokens JWT (cambiar en producción)
JWT_SECRET=
