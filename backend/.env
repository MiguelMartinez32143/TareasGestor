# ==========================================
# VARIABLES DE ENTORNO PARA DESARROLLO LOCAL
# ==========================================
# En Railway, estas variables se proveen automáticamente.
# Aquí solo se usan si ejecutas "node index.js" localmente.

# Puerto del servidor backend
PORT=3000

# Credenciales de conexión a MySQL local
MYSQLHOST=localhost
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=tareas_db
MYSQLPORT=3306

# URL del Frontend para evitar errores de CORS en Producción
CORS_ORIGIN_PROD=http://localhost:4200

# Secreto para encriptar los tokens de sesión
JWT_SECRET=clave_secreta_gestor_tareas_2026
